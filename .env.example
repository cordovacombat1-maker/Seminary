# Copy this file to ".env" for local testing (never commit .env).
# In Netlify, add each of these under: Site configuration -> Environment variables.

# Anthropic (Claude) API key — from console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Supabase — from your Supabase project -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voyage AI (embeddings for library search) — from dashboard.voyageai.com -> API Keys
VOYAGE_API_KEY=

# The email address of the one account allowed to open the Admin page
ADMIN_EMAIL=

# Optional: how many tutor messages each student may send per day (default 150)
TUTOR_DAILY_MESSAGE_LIMIT=150
